PORT=5000
# Set private admin credentials in your local .env file or hosting provider environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Optional Hugging Face token for server-side image classification. Leave empty to use browser/local detection.
HF_TOKEN=
HF_IMAGE_MODEL=google/vit-base-patch16-224
